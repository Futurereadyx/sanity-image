{
  "name": "sanity-image-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './core' --filter './next' build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "release": "pnpm build && pnpm test && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "19.2.17",
    "next": "16.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
